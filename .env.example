# Copy to .env.local for local development, and set the same variables in Vercel.
# Leave the two NEXT_PUBLIC values empty to run the app in demo mode with sample data.

# Supabase project URL and anon (or publishable) key. Public by design, row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Service role (or secret) key, used by the worker API routes. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the weekly AI worker, 32 characters or more. Generate one with: openssl rand -hex 32
WORKER_TOKEN=

# Optional. The auth user id whose data the worker reads. Needed only if the database has more than one profile.
OWNER_USER_ID=

# Optional. Time zone that decides what "today" means for the worker. Defaults to America/Lima.
APP_TIME_ZONE=America/Lima
